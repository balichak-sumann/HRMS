  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  employee_id           String?                 @unique
  is_first_login        Boolean?                @default(true)
  failed_login_attempts Int?                    @default(0)
  locked_at             DateTime?               @db.Timestamptz(6)
  status                String?                 @default("active")
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  audit_logs            audit_logs[]
  documents             documents[]
  notifications         notifications[]
  offer_letters         offer_letters[]
  password_reset_tokens password_reset_tokens[]
  payroll               payroll[]
}

model project_members {
  project_id      String    @db.Uuid
  employee_id     String    @db.Uuid
  role            String?
  role_in_project String?
  joined_at       DateTime? @default(now()) @db.Timestamptz(6)
  employees       employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects        projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project_id, employee_id])
}

model projects {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  client          String
  deadline        DateTime?         @db.Date
  status          String?           @default("Active")
  progress        Int?              @default(0)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  description     String?
  start_date      DateTime?         @db.Date
  created_by      String?           @db.Uuid
  daily_reports   daily_reports[]
  project_members project_members[]
  employees       employees?        @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  tasks           tasks[]
}

model salary_revisions {
  id                                                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                        String     @db.Uuid
  effective_date                                     DateTime   @db.Date
  proposed_basic_salary                              Decimal    @db.Decimal
  proposed_hra                                       Decimal    @db.Decimal
  proposed_allowances                                Decimal    @db.Decimal
  proposed_total_ctc                                 Decimal    @db.Decimal
  status                                             String     @default("pending")
  initiated_by                                       String?    @db.Uuid
  approved_by                                        String?    @db.Uuid
  approver_comment                                   String?
  initiated_at                                       DateTime?  @default(now()) @db.Timestamptz(6)
  approved_at                                        DateTime?  @db.Timestamptz(6)
  created_at                                         DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime?  @default(now()) @db.Timestamptz(6)
  employees_salary_revisions_approved_byToemployees  employees? @relation("salary_revisions_approved_byToemployees", fields: [approved_by], references: [id], onUpdate: NoAction)
  employees_salary_revisions_employee_idToemployees  employees  @relation("salary_revisions_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_salary_revisions_initiated_byToemployees employees? @relation("salary_revisions_initiated_byToemployees", fields: [initiated_by], references: [id], onUpdate: NoAction)

  @@index([employee_id, effective_date(sort: Desc), created_at(sort: Desc)], map: "idx_salary_revisions_employee_effective")
  @@index([status, created_at(sort: Desc)], map: "idx_salary_revisions_status")
}

model self_appraisal_items {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  self_appraisal_id String?          @db.Uuid
  goal_id           String?          @db.Uuid
  rating            Int
  comment           String?
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  goals             goals?           @relation(fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  self_appraisals   self_appraisals? @relation(fields: [self_appraisal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model self_appraisals {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id             String?                @db.Uuid
  employee_id          String?                @db.Uuid
  overall_comment      String?
  submitted_at         DateTime?              @db.Timestamptz(6)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  self_appraisal_items self_appraisal_items[]
  appraisal_cycles     appraisal_cycles?      @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees            employees?             @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cycle_id, employee_id])
  @@index([cycle_id, employee_id], map: "idx_self_appraisals_cycle_employee")
}

model shifts {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                       @unique
  start_time                 DateTime                     @db.Time(6)
  end_time                   DateTime                     @db.Time(6)
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  employee_shift_assignments employee_shift_assignments[]
}

model survey_answers {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id      String           @db.Uuid
  question_id      String           @db.Uuid
  answer_text      String
  survey_questions survey_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  survey_responses survey_responses @relation(fields: [response_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "idx_survey_answers_question")
}

model survey_questions {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey_id      String           @db.Uuid
  question_text  String
  question_type  String
  options_json   String?
  order_index    Int              @default(0)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  survey_answers survey_answers[]
  surveys        surveys          @relation(fields: [survey_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([survey_id, order_index], map: "idx_survey_questions_survey_order")
}

model survey_responses {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey_id      String           @db.Uuid
  employee_id    String?          @db.Uuid
  submitted_at   DateTime?        @default(now()) @db.Timestamptz(6)
  survey_answers survey_answers[]
  employees      employees?       @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  surveys        surveys          @relation(fields: [survey_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([survey_id, employee_id])
  @@index([survey_id, submitted_at(sort: Desc)], map: "idx_survey_responses_survey")
}

model surveys {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String
  description          String?
  created_by           String?            @db.Uuid
  target_type          String             @default("all")
  target_department_id String?            @db.Uuid
  is_anonymous         Boolean            @default(false)
  deadline             DateTime?          @db.Date
  status               String             @default("draft")
  created_at           DateTime?          @default(now()) @db.Timestamptz(6)
  survey_questions     survey_questions[]
  survey_responses     survey_responses[]
  employees            employees?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  departments          departments?       @relation(fields: [target_department_id], references: [id], onUpdate: NoAction)

  @@index([status, target_type, created_at(sort: Desc)], map: "idx_surveys_status_target")
}

model tasks {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String?    @db.Uuid
  title       String
  assignee_id String?    @db.Uuid
  status      String?    @default("todo")
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  description String?
  due_date    DateTime?  @db.Date
  employees   employees? @relation(fields: [assignee_id], references: [id], onUpdate: NoAction)
  projects    projects?  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model token_blacklist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String    @unique
  invalidated_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at     DateTime  @db.Timestamptz(6)
}
