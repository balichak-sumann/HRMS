  tds                       Decimal?                    @default(0) @db.Decimal(10, 0)
  hra                       Decimal?                    @default(0) @db.Decimal(10, 0)
  ptax                      Decimal?                    @default(200) @db.Decimal(10, 0)
  conveyance                Decimal?                    @default(0) @db.Decimal(10, 0)
  special_allowance         Decimal?                    @default(0) @db.Decimal(10, 0)
  emp_code                  String?                     @db.Text
  designation               String?                     @db.Text
  department                String?                     @db.Text
  location                  String?                     @db.Text
  processed_days            Int?                        @default(31)
  paid_days                 Int?                        @default(31)
  pan_no                    String?                     @db.Text
  bank_account              String?                     @db.Text
  bank_name                 String?                     @db.Text
  pf_employee               Decimal?                    @default(0) @db.Decimal(10, 0)
  pf_employer               Decimal?                    @default(0) @db.Decimal(10, 0)
  esi_employee              Decimal?                    @default(0) @db.Decimal(10, 0)
  esi_employer              Decimal?                    @default(0) @db.Decimal(10, 0)
  reimbursements            Decimal?                    @default(0) @db.Decimal(10, 0)
