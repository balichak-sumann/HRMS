generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model announcements {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String
  content               String
  author_id             String?                 @db.Uuid
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  employees             employees?              @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  employee_celebrations employee_celebrations[]
}

model appraisal_cycles {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  start_date             DateTime                 @db.Date
  end_date               DateTime                 @db.Date
  status                 String?                  @default("draft")
  created_by             String?                  @db.Uuid
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  employees              employees?               @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  appraisal_participants appraisal_participants[]
  goals                  goals[]
  manager_appraisals     manager_appraisals[]
  peer_feedback          peer_feedback[]
  self_appraisals        self_appraisals[]
}

model appraisal_participants {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id         String?           @db.Uuid
  employee_id      String?           @db.Uuid
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  appraisal_cycles appraisal_cycles? @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees        employees?        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cycle_id, employee_id])
  @@index([cycle_id], map: "idx_appraisal_participants_cycle")
  @@index([employee_id], map: "idx_appraisal_participants_employee")
}

model asset_assignments {
  id                                                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                                           String     @unique(map: "idx_asset_assignments_active_asset", where: raw("(return_date IS NULL)")) @db.Uuid
  employee_id                                        String     @db.Uuid
  assigned_date                                      DateTime   @db.Date
  return_date                                        DateTime?  @db.Date
  condition_notes                                    String?
  assigned_by                                        String?    @db.Uuid
  returned_by                                        String?    @db.Uuid
  created_at                                         DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime?  @default(now()) @db.Timestamptz(6)
  assets                                             assets     @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_asset_assignments_assigned_byToemployees employees? @relation("asset_assignments_assigned_byToemployees", fields: [assigned_by], references: [id], onUpdate: NoAction)
  employees_asset_assignments_employee_idToemployees employees  @relation("asset_assignments_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_asset_assignments_returned_byToemployees employees? @relation("asset_assignments_returned_byToemployees", fields: [returned_by], references: [id], onUpdate: NoAction)

  @@index([employee_id, return_date], map: "idx_asset_assignments_employee_active")
}

model assets {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  asset_type        String
  serial_number     String             @unique
  purchase_date     DateTime?          @db.Date
  asset_value       Decimal?           @db.Decimal
  status            String             @default("available")
  created_by        String?            @db.Uuid
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  asset_assignments asset_assignments?
  employees         employees?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([asset_type, status], map: "idx_assets_type_status")
}

model attendance {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String?    @db.Uuid
  check_in     DateTime   @db.Timestamptz(6)
  check_out    DateTime?  @db.Timestamptz(6)
  status       String?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  hours_worked Decimal?   @db.Decimal
  location     String?
  employees    employees? @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_email String
  full_name  String
  action     String
  module     String
  ip_address String?
  details    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  user_id    String?   @db.Uuid
  profiles   profiles? @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model chat_group_members {
  group_id    String      @db.Uuid
  employee_id String      @db.Uuid
  joined_at   DateTime?   @default(now()) @db.Timestamptz(6)
  employees   employees   @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_groups chat_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, employee_id])
}

model chat_groups {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  created_by         String?              @db.Uuid
  chat_group_members chat_group_members[]
  employees          employees?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  messages           messages[]
}

model complaints {
  id                                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                 String?    @db.Uuid
  category                                    String
  description                                 String
  attachment_url                              String?
  is_anonymous                                Boolean?   @default(false)
  status                                      String?    @default("Open")
  created_at                                  DateTime?  @default(now()) @db.Timestamptz(6)
  reviewed_by                                 String?    @db.Uuid
  attachment                                  String?
  employees_complaints_employee_idToemployees employees? @relation("complaints_employee_idToemployees", fields: [employee_id], references: [id], onUpdate: NoAction)
  employees_complaints_reviewed_byToemployees employees? @relation("complaints_reviewed_byToemployees", fields: [reviewed_by], references: [id], onUpdate: NoAction)
}

model daily_reports {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String?    @db.Uuid
  employee_id String?    @db.Uuid
  work_done   String
  hours       Decimal    @db.Decimal
  blockers    String?
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  date        DateTime?  @default(dbgenerated("CURRENT_DATE")) @db.Date
  hours_spent Decimal?   @db.Decimal
  employees   employees? @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects    projects?  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model departments {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  description String?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  employees   employees[]
  surveys     surveys[]
}

model documents {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  type        String?
  file_url    String
  employee_id String?    @db.Uuid
  status      String?    @default("Pending")
  uploaded_by String?    @db.Uuid
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  file_path   String?
  employees   employees? @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles    profiles?  @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model employee_celebrations {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String         @db.Uuid
  celebration_type String
  celebration_date DateTime       @db.Date
  announcement_id  String?        @db.Uuid
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  announcements    announcements? @relation(fields: [announcement_id], references: [id], onUpdate: NoAction)
  employees        employees      @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, celebration_type, celebration_date])
  @@index([celebration_date, celebration_type], map: "idx_employee_celebrations_date")
}

model employee_shift_assignments {
  id                                                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                                 String     @db.Uuid
  shift_id                                                    String     @db.Uuid
  effective_from                                              DateTime   @db.Date
  effective_to                                                DateTime?  @db.Date
  assigned_by                                                 String?    @db.Uuid
  created_at                                                  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                                  DateTime?  @default(now()) @db.Timestamptz(6)
  employees_employee_shift_assignments_assigned_byToemployees employees? @relation("employee_shift_assignments_assigned_byToemployees", fields: [assigned_by], references: [id], onUpdate: NoAction)
  employees_employee_shift_assignments_employee_idToemployees employees  @relation("employee_shift_assignments_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shifts                                                      shifts     @relation(fields: [shift_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id, effective_from, effective_to], map: "idx_shift_assignments_employee_dates")
  @@index([shift_id], map: "idx_shift_assignments_shift")
}

model employees {
  id                                                                             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                                                                      String
  email                                                                          String                          @unique
  role                                                                           String?
  department                                                                     String?                         @default("Engineering")
  phone                                                                          String?
  joining_date                                                                   DateTime?                       @db.Date
  salary                                                                         Decimal?                        @db.Decimal
  status                                                                         String?                         @default("Active")
  avatar_url                                                                     String?
  created_at                                                                     DateTime?                       @default(now()) @db.Timestamptz(6)
  designation                                                                    String?
  reporting_manager_id                                                           String?                         @db.Uuid
  employee_id                                                                    String?                         @unique
  updated_at                                                                     DateTime?                       @default(now()) @db.Timestamptz(6)
  manager_id                                                                     String?                         @db.Uuid
  department_id                                                                  String?                         @db.Uuid
  dob                                                                            DateTime?                       @db.Date
  pan                                                                            String?
  bank_account                                                                   String?
  bank_name                                                                      String?
  location                                                                       String?
  address                                                                        String?
  personal_email                                                                 String?
  emergency_contact                                                              String?
  technology                                                                     String?
  experience_years                                                               Decimal?                        @db.Decimal
  aadhaar_card                                                                   String?
  salary_revision_history_enabled                                                Boolean                         @default(false)
  announcements                                                                  announcements[]
  appraisal_cycles                                                               appraisal_cycles[]
  appraisal_participants                                                         appraisal_participants[]
  asset_assignments_asset_assignments_assigned_byToemployees                     asset_assignments[]             @relation("asset_assignments_assigned_byToemployees")
  asset_assignments_asset_assignments_employee_idToemployees                     asset_assignments[]             @relation("asset_assignments_employee_idToemployees")
  asset_assignments_asset_assignments_returned_byToemployees                     asset_assignments[]             @relation("asset_assignments_returned_byToemployees")
  assets                                                                         assets[]
  attendance                                                                     attendance[]
  chat_group_members                                                             chat_group_members[]
  chat_groups                                                                    chat_groups[]
  complaints_complaints_employee_idToemployees                                   complaints[]                    @relation("complaints_employee_idToemployees")
  complaints_complaints_reviewed_byToemployees                                   complaints[]                    @relation("complaints_reviewed_byToemployees")
  daily_reports                                                                  daily_reports[]
  documents                                                                      documents[]
  employee_celebrations                                                          employee_celebrations[]
  employee_shift_assignments_employee_shift_assignments_assigned_byToemployees   employee_shift_assignments[]    @relation("employee_shift_assignments_assigned_byToemployees")
  employee_shift_assignments_employee_shift_assignments_employee_idToemployees   employee_shift_assignments[]    @relation("employee_shift_assignments_employee_idToemployees")
  departments                                                                    departments?                    @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  employees_employees_manager_idToemployees                                      employees?                      @relation("employees_manager_idToemployees", fields: [manager_id], references: [id], onUpdate: NoAction)
  other_employees_employees_manager_idToemployees                                employees[]                     @relation("employees_manager_idToemployees")
  employees_employees_reporting_manager_idToemployees                            employees?                      @relation("employees_reporting_manager_idToemployees", fields: [reporting_manager_id], references: [id], onUpdate: NoAction)
  other_employees_employees_reporting_manager_idToemployees                      employees[]                     @relation("employees_reporting_manager_idToemployees")
  expense_claims_expense_claims_employee_idToemployees                           expense_claims[]                @relation("expense_claims_employee_idToemployees")
  expense_claims_expense_claims_reviewer_idToemployees                           expense_claims[]                @relation("expense_claims_reviewer_idToemployees")
  file_shares_file_shares_employee_idToemployees                                 file_shares[]                   @relation("file_shares_employee_idToemployees")
  file_shares_file_shares_shared_byToemployees                                   file_shares[]                   @relation("file_shares_shared_byToemployees")
  files                                                                          files[]
  folders                                                                        folders[]
  goals                                                                          goals[]
  helpdesk_comments                                                              helpdesk_comments[]
  helpdesk_tickets_helpdesk_tickets_assigned_toToemployees                       helpdesk_tickets[]              @relation("helpdesk_tickets_assigned_toToemployees")
  helpdesk_tickets_helpdesk_tickets_employee_idToemployees                       helpdesk_tickets[]              @relation("helpdesk_tickets_employee_idToemployees")
  income_tax_declaration_proofs                                                  income_tax_declaration_proofs[]
  income_tax_declarations                                                        income_tax_declarations[]
  leave_balances                                                                 leave_balances[]
  leave_encashment_policy                                                        leave_encashment_policy[]
  leave_encashment_requests_leave_encashment_requests_employee_idToemployees     leave_encashment_requests[]     @relation("leave_encashment_requests_employee_idToemployees")
  leave_encashment_requests_leave_encashment_requests_reviewer_idToemployees     leave_encashment_requests[]     @relation("leave_encashment_requests_reviewer_idToemployees")
  leaves_leaves_employee_idToemployees                                           leaves[]                        @relation("leaves_employee_idToemployees")
  leaves_leaves_reviewed_byToemployees                                           leaves[]                        @relation("leaves_reviewed_byToemployees")
  manager_appraisals_manager_appraisals_employee_idToemployees                   manager_appraisals[]            @relation("manager_appraisals_employee_idToemployees")
  manager_appraisals_manager_appraisals_manager_idToemployees                    manager_appraisals[]            @relation("manager_appraisals_manager_idToemployees")
  meeting_participants                                                           meeting_participants[]
  meetings                                                                       meetings[]
  messages_messages_receiver_idToemployees                                       messages[]                      @relation("messages_receiver_idToemployees")
  messages_messages_sender_idToemployees                                         messages[]                      @relation("messages_sender_idToemployees")
  offboarding_cases_offboarding_cases_employee_idToemployees                     offboarding_cases?              @relation("offboarding_cases_employee_idToemployees")
  offboarding_cases_offboarding_cases_finalized_byToemployees                    offboarding_cases[]             @relation("offboarding_cases_finalized_byToemployees")
  offboarding_cases_offboarding_cases_started_byToemployees                      offboarding_cases[]             @relation("offboarding_cases_started_byToemployees")
  offboarding_checklist_items_offboarding_checklist_items_assigned_toToemployees offboarding_checklist_items[]   @relation("offboarding_checklist_items_assigned_toToemployees")
  offboarding_checklist_items_offboarding_checklist_items_cleared_byToemployees  offboarding_checklist_items[]   @relation("offboarding_checklist_items_cleared_byToemployees")
  offboarding_exit_interviews                                                    offboarding_exit_interviews[]
  onboarding_case_tasks                                                          onboarding_case_tasks[]
  onboarding_cases_onboarding_cases_assigned_byToemployees                       onboarding_cases[]              @relation("onboarding_cases_assigned_byToemployees")
  onboarding_cases_onboarding_cases_employee_idToemployees                       onboarding_cases?               @relation("onboarding_cases_employee_idToemployees")
  onboarding_templates                                                           onboarding_templates[]
  payroll                                                                        payroll[]
  peer_feedback_peer_feedback_employee_idToemployees                             peer_feedback[]                 @relation("peer_feedback_employee_idToemployees")
  peer_feedback_peer_feedback_reviewer_idToemployees                             peer_feedback[]                 @relation("peer_feedback_reviewer_idToemployees")
  project_members                                                                project_members[]
  projects                                                                       projects[]
  salary_revisions_salary_revisions_approved_byToemployees                       salary_revisions[]              @relation("salary_revisions_approved_byToemployees")
  salary_revisions_salary_revisions_employee_idToemployees                       salary_revisions[]              @relation("salary_revisions_employee_idToemployees")
  salary_revisions_salary_revisions_initiated_byToemployees                      salary_revisions[]              @relation("salary_revisions_initiated_byToemployees")
  self_appraisals                                                                self_appraisals[]
  survey_responses                                                               survey_responses[]
  surveys                                                                        surveys[]
  tasks                                                                          tasks[]

  @@index([department_id], map: "idx_employees_department_id")
  @@index([manager_id], map: "idx_employees_manager_id")
}

model expense_claims {
  id                                              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                     String     @db.Uuid
  category                                        String
  amount                                          Decimal    @db.Decimal
  expense_date                                    DateTime   @db.Date
  description                                     String?
  receipt_url                                     String?
  status                                          String     @default("Pending")
  reviewer_id                                     String?    @db.Uuid
  reviewer_comment                                String?
  reviewed_at                                     DateTime?  @db.Timestamptz(6)
  reimbursed_payroll_id                           String?    @db.Uuid
  created_at                                      DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?  @default(now()) @db.Timestamptz(6)
  employees_expense_claims_employee_idToemployees employees  @relation("expense_claims_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payroll                                         payroll?   @relation(fields: [reimbursed_payroll_id], references: [id], onUpdate: NoAction)
  employees_expense_claims_reviewer_idToemployees employees? @relation("expense_claims_reviewer_idToemployees", fields: [reviewer_id], references: [id], onUpdate: NoAction)

  @@index([employee_id], map: "idx_expense_claims_employee")
  @@index([reimbursed_payroll_id], map: "idx_expense_claims_reimbursed")
  @@index([status], map: "idx_expense_claims_status")
}

model file_shares {
  file_id                                      String     @db.Uuid
  employee_id                                  String     @db.Uuid
  shared_by                                    String?    @db.Uuid
  shared_at                                    DateTime?  @default(now()) @db.Timestamptz(6)
  employees_file_shares_employee_idToemployees employees  @relation("file_shares_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files                                        files      @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_file_shares_shared_byToemployees   employees? @relation("file_shares_shared_byToemployees", fields: [shared_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([file_id, employee_id])
}

model files {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  folder_id    String?       @db.Uuid
  owner_id     String?       @db.Uuid
  size         BigInt
  mime_type    String?
  storage_path String
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  is_shared    Boolean?      @default(false)
  folder       String?
  file_shares  file_shares[]
  folders      folders?      @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees    employees?    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model folders {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  parent_id     String?    @db.Uuid
  owner_id      String?    @db.Uuid
  is_company    Boolean?   @default(false)
  is_hr_only    Boolean?   @default(false)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  files         files[]
  employees     employees? @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folders       folders?   @relation("foldersTofolders", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_folders folders[]  @relation("foldersTofolders")
}

model goals {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id                String?                   @db.Uuid
  employee_id             String?                   @db.Uuid
  title                   String
  description             String?
  target                  String
  progress                Int?                      @default(0)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  appraisal_cycles        appraisal_cycles?         @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees               employees?                @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager_appraisal_items manager_appraisal_items[]
  self_appraisal_items    self_appraisal_items[]

  @@index([cycle_id, employee_id], map: "idx_goals_cycle_employee")
}

model helpdesk_attachments {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String           @db.Uuid
  file_path        String
  file_name        String
  file_size        Int?
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  helpdesk_tickets helpdesk_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model helpdesk_comments {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String           @db.Uuid
  user_id          String           @db.Uuid
  comment_text     String
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamptz(6)
  helpdesk_tickets helpdesk_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees        employees        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id, created_at(sort: Desc)], map: "idx_helpdesk_comments_ticket")
  @@index([user_id], map: "idx_helpdesk_comments_user")
}

model helpdesk_tickets {
  id                                                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                       String                 @db.Uuid
  category                                          String
  subject                                           String
  description                                       String
  priority                                          String                 @default("medium")
  status                                            String                 @default("open")
  assigned_to                                       String?                @db.Uuid
  created_at                                        DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime?              @default(now()) @db.Timestamptz(6)
  resolved_at                                       DateTime?              @db.Timestamptz(6)
  closed_at                                         DateTime?              @db.Timestamptz(6)
  helpdesk_attachments                              helpdesk_attachments[]
  helpdesk_comments                                 helpdesk_comments[]
  employees_helpdesk_tickets_assigned_toToemployees employees?             @relation("helpdesk_tickets_assigned_toToemployees", fields: [assigned_to], references: [id], onUpdate: NoAction)
