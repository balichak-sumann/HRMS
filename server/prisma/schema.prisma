model salary_revisions {
  id                                                 String     @id @default(dbgenerated("(uuid())")) @db.Char(36)
  employee_id                                        String     @db.Char(36)
  effective_date                                     DateTime   @db.Date
  proposed_basic_salary                              Decimal    @db.Decimal(10, 0)
  proposed_hra                                       Decimal    @db.Decimal(10, 0)
  proposed_allowances                                Decimal    @db.Decimal(10, 0)
  proposed_total_ctc                                 Decimal    @db.Decimal(10, 0)
  status                                             String     @default("pending") @db.Text
  initiated_by                                       String?    @db.Char(36)
  approved_by                                        String?    @db.Char(36)
  approver_comment                                   String?    @db.Text
  initiated_at                                       DateTime?  @default(now())
  approved_at                                        DateTime?
  created_at                                         DateTime?  @default(now())
  updated_at                                         DateTime?  @default(now())
  employees_salary_revisions_approved_byToemployees  employees? @relation("salary_revisions_approved_byToemployees", fields: [approved_by], references: [id], onUpdate: NoAction)
  employees_salary_revisions_employee_idToemployees  employees  @relation("salary_revisions_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_salary_revisions_initiated_byToemployees employees? @relation("salary_revisions_initiated_byToemployees", fields: [initiated_by], references: [id], onUpdate: NoAction)

  @@index([employee_id, effective_date(sort: Desc), created_at(sort: Desc)], map: "idx_salary_revisions_employee_effective")
  @@index([status(length: 191), created_at(sort: Desc)], map: "idx_salary_revisions_status")
  @@index([approved_by], map: "salary_revisions_approved_by_fkey")
  @@index([initiated_by], map: "salary_revisions_initiated_by_fkey")
}

